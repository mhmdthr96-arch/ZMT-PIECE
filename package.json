{
  "name": "zmt-piece",
  "version": "2.2.5",
  "description": "ZMT PIECE - برنامج إدارة قطع غيار السيارات",
  "main": "main.js",
  "author": "ZERIBIT MOHAMMED TAHAR - ZMT SOFTWARE",
  "license": "MIT",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dev": "electron . --dev --no-sandbox",
    "debug": "electron . --no-sandbox --disable-gpu --enable-logging",
    "dist": "electron-builder --win --x64",
    "dist:all": "electron-builder --win",
    "dist:dir": "electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.zmtsoftware.piece",
    "productName": "ZMT PIECE",
    "copyright": "Copyright © 2026 ZERIBIT MOHAMMED TAHAR — ZMT SOFTWARE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "license.js",
      "firebird.js",
      "lan-server.js",
      "renderer/**/*",
      "assets/**/*",
      "supabase/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "firebird-runtime",
        "to": "firebird",
        "filter": [
          "**/*"
        ]
      },
      "AnyDesk.exe"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/sql.js/**",
      "node_modules/@supabase/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZMT PIECE",
      "unicode": true,
      "license": "build/eula.txt",
      "language": "1025"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "chart.js": "^4.5.1",
    "iconv-lite": "^0.7.3",
    "papaparse": "^5.5.4",
    "simple-icons": "^16.25.0",
    "sql.js": "^1.14.1",
    "xlsx": "^0.18.5"
  }
}
